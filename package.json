{
  "scripts": {
    "prepare": "husky",
    "lint:commits": "commitlint --from=HEAD~1",
    "validate:branch-name": "node ./scripts/validate-branch-name.mjs",
    "validate:pr-title": "echo \"PR title is validated in GitHub Actions\"",
    "test:flutter": "flutter test",
    "test:backend": "npm test --prefix backend -- --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test:flutter && npm run test:backend && npm run test:e2e"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "agentation": "^1.3.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.42.1",
    "@types/node": "^20.11.24",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "wrangler": "^4.127.1"
  }
}
